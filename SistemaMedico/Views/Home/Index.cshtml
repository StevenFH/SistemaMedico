@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mt-5 mb-5">
    <h1 class="display-4 fw-bold text-primary"><i class="bi bi-heart-pulse text-danger"></i> MediStock</h1>
    <p class="lead text-muted">Sistema de control de inventario médico y categorización</p>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-md-5">
        <div class="card card-custom h-100 p-4 text-center">
            <div class="card-body">
                <i class="bi bi-tags text-primary" style="font-size: 3rem;"></i>
                <h3 class="card-title mt-3">Categorías</h3>
                <p class="card-text text-muted">Gestione las familias de productos médicos, clasificaciones y tipos de insumos.</p>
                <a asp-controller="Categorias" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 mt-2">Administrar Categorías</a>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card card-custom h-100 p-4 text-center">
            <div class="card-body">
                <i class="bi bi-box-seam text-success" style="font-size: 3rem;"></i>
                <h3 class="card-title mt-3">Productos</h3>
                <p class="card-text text-muted">Controle el inventario detallado, precios, cantidades y asignación de categorías.</p>
                <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-success rounded-pill px-4 mt-2">Administrar Productos</a>
            </div>
        </div>
    </div>
</div>