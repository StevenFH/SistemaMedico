@model SistemaMedico.Application.DTOs.ProductoDTO
@{
    ViewData["Title"] = "Crear Producto";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card card-custom mt-4">
            <div class="card-header bg-white pb-0 border-0 mt-3 ms-3">
                <h3 class="fw-bold"><i class="bi bi-plus-circle text-success me-2"></i>Registrar Producto</h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label fw-semibold"></label>
                            <input asp-for="Nombre" class="form-control bg-light" placeholder="Ej. Paracetamol 500mg" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoriaId" class="form-label fw-semibold">Categoría</label>
                            <select asp-for="CategoriaId" class="form-select bg-light" asp-items="ViewBag.Categorias">
                                <option value="">-- Seleccione una Categoría --</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Precio" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white">₡</span>
                                <input asp-for="Precio" type="number" step="0.01" class="form-control bg-light" />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Cantidad" class="form-label fw-semibold"></label>
                            <input asp-for="Cantidad" type="number" class="form-control bg-light" />
                            <span asp-validation-for="Cantidad" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                            <textarea asp-for="Descripcion" class="form-control bg-light" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="mt-4 text-end">
                        <a asp-action="Index" class="btn btn-light me-2"><i class="bi bi-x-circle me-1"></i>Cancelar</a>
                        <button type="submit" class="btn btn-success"><i class="bi bi-save me-1"></i>Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}