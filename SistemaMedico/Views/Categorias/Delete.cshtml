@model SistemaMedico.Application.DTOs.CategoriaDTO
@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <!-- Alerta de error si falla la eliminación por tener productos -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm mt-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card card-custom mt-4 border-danger border-top border-4">
            <div class="card-body p-4 text-center">
                <i class="bi bi-exclamation-circle text-danger mb-3" style="font-size: 4rem;"></i>
                <h2 class="fw-bold">¿Está seguro?</h2>
                <p class="text-muted fs-5">Está a punto de eliminar la categoría <strong>@Model.Nombre</strong>.</p>

                <div class="bg-light p-3 rounded-3 my-4 text-start">
                    <p class="mb-1"><strong>Descripción:</strong> @Model.Descripcion</p>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-secondary rounded-pill px-4 me-2"><i class="bi bi-arrow-left me-1"></i> Cancelar</a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4"><i class="bi bi-trash me-1"></i> Sí, eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>