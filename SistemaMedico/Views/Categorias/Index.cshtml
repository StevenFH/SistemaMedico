@model IEnumerable<SistemaMedico.Application.DTOs.CategoriaDTO>
@{
    ViewData["Title"] = "Categorías";
}

<div class="card card-custom mt-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0"><i class="bi bi-tags text-primary me-2"></i>Categorías Registradas</h3>
            <a asp-action="Create" class="btn btn-primary rounded-pill shadow-sm"><i class="bi bi-plus-lg me-1"></i>Nueva</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Nombre</th>
                        <th>Descripción</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold text-dark">@item.Nombre</td>
                            <td class="text-muted">@item.Descripcion</td>
                            <td class="text-end pe-3">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1" title="Editar"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>