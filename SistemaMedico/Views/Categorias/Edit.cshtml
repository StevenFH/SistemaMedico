@model SistemaMedico.Application.DTOs.CategoriaDTO
@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card card-custom mt-4">
            <div class="card-header bg-white pb-0 border-0 mt-3 ms-3">
                <h3 class="fw-bold"><i class="bi bi-pencil-square text-warning me-2"></i>Editar Categoría</h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Nombre" class="form-label fw-semibold"></label>
                            <input asp-for="Nombre" class="form-control form-control-lg bg-light" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                            <textarea asp-for="Descripcion" class="form-control bg-light" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="mt-4 text-end">
                        <a asp-action="Index" class="btn btn-light me-2"><i class="bi bi-x-circle me-1"></i>Cancelar</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Actualizar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}